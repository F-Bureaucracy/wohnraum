# Drizzle
# Replace with your DB credentials!
# DATABASE_URL="libsql://db-name-user.turso.io"
# A local DB can also be used in dev as well
# DATABASE_URL="file:local.db"
DATABASE_AUTH_TOKEN=""

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# SMTP (used for password reset and other transactional emails)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@example.com"

# f-bau OAuth provider
FBAU_ISSUER="http://localhost:5173"
FBAU_CLIENT_ID=""
FBAU_CLIENT_SECRET=""
