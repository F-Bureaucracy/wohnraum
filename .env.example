# Drizzle
# Replace with your DB credentials!
# DATABASE_URL="libsql://db-name-user.turso.io"
# A local DB can also be used in dev as well
# DATABASE_URL="file:local.db"
DATABASE_AUTH_TOKEN=""

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# SMTP (used for password reset and other transactional emails)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@example.com"

# f-bau OAuth provider
FBAU_ISSUER="http://localhost:5173"
FBAU_CLIENT_ID=""
FBAU_CLIENT_SECRET=""

# S3-compatible object storage (used for Mietobjekt image uploads)
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
# Endpoint URL of the S3-compatible service (e.g. Hetzner: https://nbg1.your-objectstorage.com)
S3_URL=""
# Set to "true" for path-style (https://endpoint/bucket/key), "false" for virtual-hosted (https://bucket.endpoint/key)
S3_FORCE_PATH_STYLE="false"

# f-omnes report generation service. The app sends DATABASE_URL as the
# connection string so f-omnes can read the database to build the report.
OMNES_URL="https://omnes.f-bau.ai"
# Optional bearer token if the f-omnes deployment requires authentication.
OMNES_API_KEY=""
